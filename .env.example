# Supabase auth project — must be set in production (Vercel env vars).
# For local dev: copy this file to .env.local and fill in your dev project's
# values. .env.local is gitignored.
#
# Get these from supabase.com → your project → Settings → API.
#
# IMPORTANT: this project is what isolates HIV-dashboard users from any
# other studies (AL, AHIP, etc.) that may share a different Supabase
# project. Don't set these to the legacy `prism-dashboard-al-auth` project
# unless you want shared auth.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
