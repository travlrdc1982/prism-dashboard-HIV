# Copy to .env.local and fill in values.

# Supabase auth (required when BYPASS_AUTH=false in App.jsx)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API server (optional — only needed for the HIV tab; defaults to localhost:8000)
VITE_API_BASE=http://localhost:8000/api

# Study ID served by the API (defaults to hiv-wave1)
VITE_STUDY_ID=hiv-wave1
